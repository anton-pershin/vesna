VESNA_PUBLIC_ORIGIN=https://replace-with-current-temporary-origin.trycloudflare.com
VESNA_PASSWORD_HASH=replace-with-output-from-vesna-password-hash
VESNA_DATABASE=/var/lib/vesna/vesna.sqlite3
VESNA_ARTIFACT_ROOT=/var/lib/vesna/artifacts
VESNA_STATIC_DIR=/opt/vesna/public
VESNA_SESSION_TTL_SECONDS=604800
VESNA_UPLOAD_MAX_BYTES=1048576
VESNA_REQUEST_MAX_BYTES=1261568
