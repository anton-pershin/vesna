VESNA_TTS_RESPONSE_MAX_BYTES=25000000
VESNA_TTS_ENGINE_TIMEOUT=120
VESNA_TTS_ENGINE_COMMAND="/opt/vesna/venv/bin/python -m piper --model /opt/vesna/models/joe/en_US-joe-medium.onnx --config /opt/vesna/models/joe/en_US-joe-medium.onnx.json --input-file {input} --output-file {output} --length-scale 1.0 --noise-scale 0.5 --noise-w-scale 0.333 --sentence-silence 0.0"
