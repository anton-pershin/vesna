[Unit]
Description=Vesna loopback-only text-to-speech adapter

[Service]
Type=simple
User=vesna
Group=vesna
WorkingDirectory=/opt/vesna
Environment=PYTHONUNBUFFERED=1
Environment=HF_HOME=/var/lib/vesna/huggingface
Environment=XDG_CACHE_HOME=/var/lib/vesna/cache
EnvironmentFile=/etc/vesna/tts.env
ExecStart=/opt/vesna/venv/bin/vesna-tts
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
StateDirectory=vesna
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/vesna

[Install]
WantedBy=multi-user.target
